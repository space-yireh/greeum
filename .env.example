# Required for image generation (server only)
OPENROUTER_API_KEY=
# Optional override; matches the application default
OPENROUTER_MODEL=openai/gpt-image-2.5-sunburst
# Must exactly match the browser origin; required in production
APP_ORIGIN=http://localhost:3000

# Optional: enable temporary result storage only when BOTH are configured.
# Use a Private Vercel Blob store and a CRON_SECRET of at least 32 characters.
# Download links expire after 1 hour; daily cron deletes results older than 24 hours.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# Optional legacy comparison tool only (not used by the web app)
# OPENROUTER_BASELINE_MODEL=google/gemini-nano-banana-2.1
# CARICATURE_STYLE_REFERENCE_LAYOUT=paired
